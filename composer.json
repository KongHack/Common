{
  "name": "gcworld/common",
  "description": "GCWorld Industries Common",
  "authors": [
    {
      "name": "GameCharmer",
      "email": "admin@gamecharmer.com"
    }
  ],
  "require": {
    "php": ">=8.4",
    "ext-pdo": "*",
    "ext-redis": "*",
    "gcworld/database": "^2.8",
    "gcworld/errorhandlers": "^1.2",
    "gcworld/interfaces": "^4.5",
    "symfony/yaml": "^6.4"
  },
  "require-dev": {
    "phpstan/phpstan": "^1.9",
    "phpmd/phpmd": "^2.8.1"
  },
  "scripts": {
    "lint": "find src -name '*.php' -print0 | xargs -0 -n1 php -l",
    "phpstan": "phpstan analyse --no-progress --memory-limit=1G",
    "phpmd": "phpmd src ansi phpmd.xml",
    "check": [
      "@lint",
      "@phpstan",
      "@phpmd"
    ]
  },
  "autoload": {
    "psr-4": {
      "GCWorld\\Common\\": "src/"
    }
  },
  "license":"proprietary",
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "composer/installers": true
    }
  }
}
