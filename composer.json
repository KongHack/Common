{
  "name": "gcworld/common",
  "description": "GCWorld Industries Common",
  "authors": [
    {
      "name": "GameCharmer",
      "email": "admin@gamecharmer.com"
    }
  ],
  "require": {
    "php": ">=8.4",
    "ext-pdo": "*",
    "ext-redis": "*",
    "gcworld/database": "^2.8",
    "gcworld/errorhandlers": "^1.2",
    "gcworld/interfaces": ">=4.5",
    "symfony/yaml": "^6.4"
  },
  "require-dev": {
    "phpstan/phpstan": "^1.9",
    "phpmd/phpmd": "^2.8.1"
  },
  "autoload": {
    "psr-4": {
      "GCWorld\\Common\\": "src/"
    }
  },
  "license":"proprietary",
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "composer/installers": true
    }
  }
}
