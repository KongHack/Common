{
  "name": "gcworld/common",
  "description": "GCWorld Industries Common",
  "authors": [
    {
      "name": "GameCharmer",
      "email": "admin@gamecharmer.com"
    }
  ],
  "require": {
    "php": ">=8.4",
    "ext-pdo": "*",
    "ext-redis": "*",
    "gcworld/database": "^2.8",
    "gcworld/errorhandlers": "^1.2",
    "gcworld/interfaces": "^4.5",
    "symfony/yaml": "^6.4"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^12.0"
  },
  "scripts": {
    "lint": "find src tests -name '*.php' -print0 | xargs -0 -n1 php -l",
    "phpstan": "phpstan analyse --no-progress --memory-limit=1G",
    "test": "phpunit",
    "check": [
      "@lint",
      "@phpstan",
      "@test"
    ]
  },
  "autoload": {
    "psr-4": {
      "GCWorld\\Common\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "GCWorld\\Common\\Tests\\": "tests/"
    }
  },
  "license":"proprietary",
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "composer/installers": true
    }
  }
}
